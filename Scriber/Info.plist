<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Scriber</string>
    <key>CFBundleExecutable</key>
    <string>Scriber</string>
    <key>CFBundleIdentifier</key>
    <string>com.gafiegarcia.scriber</string>
    <!-- Written into Contents/PkgInfo at build time. Absent, the file says
         "????????" and `spctl --type exec` declines to assess the bundle as an
         application; nothing generates these because GENERATE_INFOPLIST_FILE is
         off. -->
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleName</key>
    <string>Scriber</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Scriber uses your microphone while testing input during setup and while a dictation shortcut is active.</string>
    <!-- macOS prefixes this with its own fixed sentence about recording system
         audio, so denying the verb reads as a contradiction. Explain the
         mechanism instead: the tap's callback discards every sample it is
         handed. -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>Scriber silences other apps while you dictate, so they don't bleed into your microphone. It never reads or saves what they play.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Sparkle. The appcast is a release asset, so `latest` always serves the
         newest release's copy. The public key pairs with the private key held in
         the login Keychain under the account `scriber`; an update not signed with
         that private key is refused, wherever it was fetched from. Checks are
         switched on here rather than asked about: Sparkle's permission prompt is a
         window, and Scriber's own Settings switch decides only whether an update
         installs itself. -->
    <key>SUFeedURL</key>
    <string>https://github.com/gafiegarcia/scriber/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>qtc3YwvRV9VeGSjKronQmpKQAvRuSgYYCO1avljjlyc=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
