# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
/dist-desktop/

# scriber cli bundle (generated by scripts/build-cli.js during prepack)
/.scriber-cli/

# pinned local FFmpeg source/build cache + generated macOS artifacts
/.ffmpeg-build/
/.ffmpeg/

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# source font files (variable fonts copied to public/fonts/)
/webfonts

# stray screenshot artifacts from agent self-debugging (computer-use MCP saves outside the repo,
# but this guards against any PNG accidentally dropped into the tree)
*.png
!public/icon-*.png

# local dev assets (design files, test recordings, etc.)
.local/
stitch_*/

# editor configs (single-developer project — keep these local)
.vscode/

# ai assistants
.claude/
.gemini/
GEMINI.md
